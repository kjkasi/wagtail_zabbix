# Copy these values into your shell or your deployment secret manager.
# This project does not load .env files automatically.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Development defaults to Django's console email backend. These SMTP values
# are used when EMAIL_BACKEND is set to the SMTP backend (or in production).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-a-secret
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=notifications@example.com
SERVER_EMAIL=server@example.com
EMAIL_SUBJECT_PREFIX=[Wagtail Zabbix] 
